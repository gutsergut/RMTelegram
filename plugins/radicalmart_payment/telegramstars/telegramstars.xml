<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="radicalmart_payment" method="upgrade" version="5.0">
    <name>plg_radicalmart_payment_telegramstars</name>
    <author>Project Team</author>
    <version>0.1.0</version>
    <description>PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_XML_DESCRIPTION</description>
    <files>
        <filename plugin="telegramstars">telegramstars.php</filename>
    </files>
    <languages folder="language">
        <language tag="ru-RU">ru-RU/plg_radicalmart_payment_telegramstars.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_FIELDSET_BASIC">
                <field name="bot_only" type="radio" default="1" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_BOT_ONLY_LABEL" description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_BOT_ONLY_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="conversion_percent" type="number" default="5" step="0.1" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_CONV_LABEL" description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_CONV_DESC"/>
                <field name="rub_per_star" type="number" default="2" step="0.01" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_RUB_PER_STAR_LABEL" description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_RUB_PER_STAR_DESC"/>
                <field name="auto_update_rate" type="radio" default="0" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_AUTO_RATE_LABEL" description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_AUTO_RATE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="rate_last_updated" type="text" readonly="true" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_RATE_UPDATED_LABEL" description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_RATE_UPDATED_DESC"/>
            </fieldset>
            <fieldset name="restrictions" label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_FIELDSET_RESTRICTIONS">
                <field name="allowed_categories"
                       type="categories"
                       multiple="true"
                       label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_ALLOWED_CATS_LABEL"
                       description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_ALLOWED_CATS_DESC"
                       addfieldprefix="Joomla\Component\RadicalMart\Administrator\Field"/>
                <field name="excluded_categories"
                       type="categories"
                       multiple="true"
                       label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_EXCLUDED_CATS_LABEL"
                       description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_EXCLUDED_CATS_DESC"
                       addfieldprefix="Joomla\Component\RadicalMart\Administrator\Field"/>
                <field name="allowed_products"
                       type="modal_product"
                       multiple="true"
                       label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_ALLOWED_PROD_LABEL"
                       description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_ALLOWED_PROD_DESC"
                       addfieldprefix="Joomla\Component\RadicalMart\Administrator\Field"/>
                <field name="excluded_products"
                       type="modal_product"
                       multiple="true"
                       label="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_EXCLUDED_PROD_LABEL"
                       description="PLG_RADICALMART_PAYMENT_TELEGRAMSTARS_EXCLUDED_PROD_DESC"
                       addfieldprefix="Joomla\Component\RadicalMart\Administrator\Field"/>
            </fieldset>
        </fields>
    </config>
</extension>
